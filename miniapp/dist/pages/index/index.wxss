.elderly-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.fall-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(245, 34, 45, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
  border-radius: 16rpx;
  animation: pulse 1.5s infinite;
}

.fall-icon {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.fall-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #f5222d;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.8;
  }
  50% {
    opacity: 1;
  }
}
.ec-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ec-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-left: 8rpx;
}

.ec-room {
  font-size: 26rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.ec-body {
  margin-bottom: 16rpx;
}

.ec-vital {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.ec-vital-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ec-vital-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.ec-vital-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.ec-posture {
  font-size: 32rpx !important;
}

.ec-vital-unit {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.ec-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e8e8e8;
}

.ec-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ec-device-count {
  font-size: 22rpx;
  color: #52c41a;
  margin-right: 12rpx;
}

.ec-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  background: #f5222d;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 18rpx;
  padding: 0 8rpx;
  animation: blink 1.5s infinite;
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}
