.mine-page{min-height:100vh;padding:20rpx}.mine-header{align-items:center;display:flex;flex-direction:column;padding:48rpx 0}.mine-avatar{align-items:center;background:linear-gradient(135deg,#1890ff,#69c0ff);border-radius:50%;display:flex;height:120rpx;justify-content:center;margin-bottom:20rpx;width:120rpx}.avatar-text{color:#fff;font-size:48rpx;font-weight:700}.mine-name{color:#333;font-size:34rpx;font-weight:600;margin-bottom:8rpx}.mine-menu-item{align-items:center;border-bottom:1rpx solid #f5f5f5;display:flex;flex-direction:row;justify-content:space-between;padding:28rpx 0}.mine-menu-item:last-child{border-bottom:none}.mine-menu-label{color:#333;display:block;font-size:28rpx;margin-bottom:6rpx}.mine-arrow{color:#ccc;font-size:28rpx}