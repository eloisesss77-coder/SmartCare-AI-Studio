.alert-detail-page {
  padding: 20rpx;
  min-height: 100vh;
}

.level-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.ad-type {
  font-size: 32rpx;
  font-weight: 700;
}

.ad-info {
  margin: 20rpx 0;
}

.ad-info-row {
  display: flex;
  flex-direction: row;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.ad-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
}

.ad-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.ad-message-box {
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 24rpx;
}

.ad-message {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.ad-actions {
  margin-top: 32rpx;
}
