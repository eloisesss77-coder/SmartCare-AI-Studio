.bind-page {
  padding: 20rpx;
  min-height: 100vh;
}

.bind-title {
  font-size: 34rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.bind-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.bind-input-group {
  margin-bottom: 24rpx;
}

.bind-label {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.bind-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.bind-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  background: #fafafa;
}

.relation-list {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.relation-chip {
  padding: 16rpx 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
}

.relation-chip-active {
  color: #1890ff;
  background: #e6f7ff;
  font-weight: 600;
}

.bind-tips {
  margin-top: 32rpx;
  text-align: center;
}

.btn-loading {
  opacity: 0.6;
}
