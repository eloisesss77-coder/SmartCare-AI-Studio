.bind-page{min-height:100vh;padding:20rpx}.bind-title{display:block;font-size:34rpx;font-weight:700;margin-bottom:12rpx}.bind-desc{color:#999;display:block;font-size:26rpx;line-height:1.5;margin-bottom:32rpx}.bind-input-group{margin-bottom:24rpx}.bind-label{color:#333;display:block;font-size:26rpx;font-weight:500;margin-bottom:12rpx}.bind-input-row{align-items:center;display:flex;flex-direction:row;gap:16rpx}.bind-input{background:#fafafa;border:2rpx solid #d9d9d9;border-radius:12rpx;flex:1;font-size:32rpx;height:80rpx;letter-spacing:8rpx;padding:0 24rpx;text-align:center}.relation-list{display:flex;flex-direction:row;gap:16rpx}.relation-chip{background:#f5f5f5;border-radius:8rpx;color:#666;font-size:26rpx;padding:16rpx 28rpx}.relation-chip-active{background:#e6f7ff;color:#1890ff;font-weight:600}.bind-tips{margin-top:32rpx;text-align:center}.btn-loading{opacity:.6}