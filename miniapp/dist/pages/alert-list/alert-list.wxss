.alert-page {
  padding: 20rpx;
  min-height: 100vh;
}

.filter-bar {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.filter-chip {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.filter-chip-active {
  color: #1890ff;
  background: #e6f7ff;
  font-weight: 600;
}

.alert-list {
  height: calc(100vh - 160rpx);
}

.alert-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

.alert-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 8rpx;
}

.alert-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.alert-level {
  font-size: 22rpx;
  margin-left: 12rpx;
}

.alert-msg {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}
