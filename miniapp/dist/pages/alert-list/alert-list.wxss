.alert-page{min-height:100vh;padding:20rpx}.filter-bar{display:flex;flex-direction:row;gap:12rpx;margin-bottom:20rpx}.filter-chip{background:#fff;border-radius:8rpx;color:#666;font-size:26rpx;padding:12rpx 24rpx}.filter-chip-active{background:#e6f7ff;color:#1890ff;font-weight:600}.alert-list{height:calc(100vh - 160rpx)}.alert-item{background:#fff;border-radius:12rpx;box-shadow:0 1rpx 6rpx rgba(0,0,0,.04);margin-bottom:16rpx;padding:24rpx}.alert-dot{border-radius:50%;height:12rpx;margin-right:16rpx;margin-top:8rpx;width:12rpx}.alert-type{color:#333;font-size:28rpx;font-weight:600}.alert-level{font-size:22rpx;margin-left:12rpx}.alert-msg{color:#666;font-size:24rpx;line-height:1.5}