  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.daily-vital-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.daily-vital-value {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.daily-vital-unit {
  font-size: 20rpx;
  color: #999;
}

.daily-footer {
  display: flex;
  flex-direction: row;
}
