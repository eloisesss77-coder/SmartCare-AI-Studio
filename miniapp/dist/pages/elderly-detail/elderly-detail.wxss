.detail-page {
  padding: 20rpx;
  min-height: 100vh;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 700;
}

.detail-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.tab-bar {
  display: flex;
  flex-direction: row;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.tab-active {
  color: #1890ff;
  font-weight: 600;
  border-bottom-color: #1890ff;
}

.daily-card {
  margin-bottom: 16rpx;
}

.daily-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.daily-vitals {
  display: flex;
  flex-direction: row;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

