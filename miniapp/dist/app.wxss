page{background-color:#f5f5f5;color:#333;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,sans-serif;font-size:28rpx}.container{padding:24rpx}.card{background:#fff;border-radius:16rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.06);margin-bottom:24rpx;padding:24rpx}.flex-row{align-items:center;display:flex;flex-direction:row}.flex-between{align-items:center;display:flex;flex-direction:row;justify-content:space-between}.flex-col{display:flex;flex-direction:column}.text-center{text-align:center}.text-right{text-align:right}.text-muted{color:#999;font-size:24rpx}.text-danger{color:#f5222d}.text-warning{color:#fa8c16}.text-success{color:#52c41a}.text-primary{color:#1890ff}.mt-8{margin-top:8rpx}.mt-16{margin-top:16rpx}.mt-24{margin-top:24rpx}.mb-16{margin-bottom:16rpx}.mr-8{margin-right:8rpx}.mr-16{margin-right:16rpx}.p-16{padding:16rpx}.status-dot{border-radius:50%;display:inline-block;height:16rpx;margin-right:8rpx;width:16rpx}.status-dot-green{background-color:#52c41a}.status-dot-yellow{background-color:#fa8c16}.status-dot-red{animation:blink 1s infinite;background-color:#f5222d}.status-dot-gray{background-color:#d9d9d9}@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}.alert-banner{background:linear-gradient(135deg,#fff1f0,#ffccc7);border-left:6rpx solid #f5222d;border-radius:8rpx;margin-bottom:16rpx;padding:16rpx 20rpx}.big-number{font-size:64rpx;font-weight:700;line-height:1}.big-number-unit{color:#999;font-size:24rpx;font-weight:400;margin-left:4rpx}.tag{border-radius:4rpx;display:inline-block;font-size:22rpx;padding:4rpx 12rpx}.tag-green{background:#f6ffed;border:1rpx solid #b7eb8f;color:#52c41a}.tag-red{background:#fff1f0;border:1rpx solid #ffa39e;color:#f5222d}.tag-orange{background:#fff7e6;border:1rpx solid #ffd591;color:#fa8c16}.tag-blue{background:#e6f7ff;border:1rpx solid #91d5ff;color:#1890ff}.tag-default{background:#fafafa;border:1rpx solid #d9d9d9;color:#999}.btn{align-items:center;border-radius:8rpx;display:inline-flex;font-size:28rpx;font-weight:500;justify-content:center;padding:16rpx 32rpx}.btn-primary{background:#1890ff;color:#fff}.btn-danger{background:#f5222d;color:#fff}.btn-outline{background:#fff;border:2rpx solid #1890ff;color:#1890ff}.btn-block{display:flex;width:100%}