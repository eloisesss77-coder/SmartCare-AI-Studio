@charset "UTF-8";
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f5f5;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-muted {
  color: #999999;
  font-size: 24rpx;
}

.text-danger {
  color: #f5222d;
}

.text-warning {
  color: #fa8c16;
}

.text-success {
  color: #52c41a;
}

.text-primary {
  color: #1890ff;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mr-8 {
  margin-right: 8rpx;
}

.mr-16 {
  margin-right: 16rpx;
}

.p-16 {
  padding: 16rpx;
}

/* 状态指示灯 */
.status-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot-green {
  background-color: #52c41a;
}

.status-dot-yellow {
  background-color: #fa8c16;
}

.status-dot-red {
  background-color: #f5222d;
  animation: blink 1s infinite;
}

.status-dot-gray {
  background-color: #d9d9d9;
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}
/* 告警横条 */
.alert-banner {
  background: linear-gradient(135deg, #fff1f0, #ffccc7);
  border-left: 6rpx solid #f5222d;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

/* 大号数字 */
.big-number {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.big-number-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #999;
  margin-left: 4rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-green {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.tag-red {
  background: #fff1f0;
  color: #f5222d;
  border: 1rpx solid #ffa39e;
}

.tag-orange {
  background: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.tag-blue {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.tag-default {
  background: #fafafa;
  color: #999;
  border: 1rpx solid #d9d9d9;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary {
  background: #1890ff;
  color: #fff;
}

.btn-danger {
  background: #f5222d;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

.btn-block {
  display: flex;
  width: 100%;
}
